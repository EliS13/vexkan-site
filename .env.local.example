# Sign-in is optional. Without these the site still works and saves to the
# browser only. With them, notebooks and season plans follow a team between
# devices.
#
# 1. Make a free project at https://supabase.com
# 2. Run supabase/migrations/0001_init.sql in the SQL editor
# 3. Project Settings, API, copy the two values below
# 4. Save this file as .env.local and restart the dev server
#
# The anon key is safe to expose. Row level security in the database is what
# keeps one team from reading another team's rows.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Live Alberta competitions from events.vex.com.
#
# Server-only on purpose: no NEXT_PUBLIC_ prefix, because this is a credential
# and that prefix would ship it to the browser in the page source.
#
# Without it the competitions section falls back to the events kept by hand in
# src/content/club/events.ts and says the live list is not switched on.
VEX_API_TOKEN=
